{
  "name": "deterministic-workflows",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "smoke:deliver": "bun run src/examples/nwave/deliver/smoke.ts",
    "smoke:oracle": "bun run src/examples/nwave/distill/smoke.ts",
    "todo:roadmap": "bun run src/examples/nwave/todo/roadmap.ts",
    "todo:review": "bun run src/examples/nwave/todo/review.ts",
    "todo:distill": "bun run src/examples/nwave/todo/distill.ts",
    "todo:deliver": "bun run src/examples/nwave/todo/deliver.ts",
    "todo:resume": "bun run src/examples/nwave/todo/resume.ts",
    "todo:report": "bun run src/examples/nwave/todo/summary.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "@mastra/core": "^1.66.0",
    "@mastra/libsql": "^1.22.5",
    "tree-sitter": "^0.25.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.6.2"
  }
}
