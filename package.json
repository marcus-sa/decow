{
  "name": "deterministic-workflows",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test ./packages ./examples ./targets/todo/.des",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "smoke:deliver": "bun run examples/nwave/deliver/smoke.ts",
    "smoke:oracle": "bun run examples/nwave/distill/smoke.ts",
    "todo:roadmap": "bun run targets/todo/.des/roadmap.ts",
    "todo:review": "bun run targets/todo/.des/review.ts",
    "todo:distill": "bun run targets/todo/.des/distill.ts",
    "todo:deliver": "bun run targets/todo/.des/deliver.ts",
    "todo:resume": "bun run targets/todo/.des/resume.ts",
    "todo:report": "bun run targets/todo/.des/summary.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@des/core": "workspace:*",
    "zod": "^4.6.2"
  }
}
