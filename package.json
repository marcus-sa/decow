{
  "name": "deterministic-workflows",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test ./packages ./examples ./targets/todo/.des",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "ui:build": "bun run --filter @des/ui build",
    "smoke:deliver": "bun run examples/nwave/deliver/smoke.ts",
    "smoke:oracle": "bun run examples/nwave/distill/smoke.ts",
    "todo": "bun run targets/todo/.des/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@des/core": "workspace:*",
    "zod": "^4.6.2",
    "@des/server": "workspace:*",
    "@des/ui": "workspace:*"
  }
}
