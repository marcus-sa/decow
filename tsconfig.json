{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // `packages/` is the workspace — `@des/core`, `@des/server`, `@des/ui` — and
  // `examples/` is one consumer's waves; both are this repository. ONE
  // tsconfig over all of it, so `bunx tsc --noEmit` at the root is a
  // meaningful gate for every package at once and a cross-package type error
  // cannot hide behind a per-package check nobody ran. `@des/*` resolves
  // through each package's own `exports` map rather than through `paths`,
  // because `moduleResolution: "bundler"` reads exports and bun resolves the
  // same way at run time — one resolution story rather than two.
  //
  // `targets/*/commands.ts` and `targets/*/.des` are the files in a target
  // that are OURS to typecheck: the first declares conformance to the
  // framework's `Commands` type, and a declaration nothing checks is a
  // declaration that drifts; the second is the composition that drives the
  // waves against that target. Everything else in a target is that target's
  // own project, typechecked by the write path's own declared typecheck
  // command inside a run; `runs/` holds the copies.
  "include": ["packages", "examples", "targets/*/commands.ts", "targets/*/.des"],
  "exclude": ["node_modules", "runs", "packages/ui/.output", "packages/ui/.nitro", "packages/ui/dist"]
}
